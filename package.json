{
  "name": "crashpack",
  "version": "0.4.1",
  "description": "Everything your bug report needs, in one command.",
  "type": "module",
  "bin": {
    "crashpack": "dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poorvith-mp/crashpack.git"
  },
  "homepage": "https://crashpack.poorvithmp.com",
  "bugs": {
    "url": "https://github.com/poorvith-mp/crashpack/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.site.json",
    "prepack": "tsup",
    "build:site": "node scripts/build-site.mjs",
    "dev:site": "node scripts/serve-site.mjs",
    "deploy:site": "npx wrangler@4.125.0 deploy"
  },
  "keywords": [
    "crashpack",
    "bug-report",
    "debugging",
    "diagnostics",
    "developer-tools",
    "git",
    "redaction",
    "cli"
  ],
  "author": "Poorvith M P <poorvith007@proton.me>",
  "license": "MIT",
  "dependencies": {
    "clipboardy": "^4.0.0",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "gsap": "^3.15.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
